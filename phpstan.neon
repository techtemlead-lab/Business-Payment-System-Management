includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Static analysis for application code. Existing findings live in phpstan-baseline.neon;
    # new code must pass at this level. Regenerate the baseline only when fixing old findings:
    # `composer analyse -- --generate-baseline`.
    level: 5
    paths:
        - app/
    tmpDir: storage/framework/cache/phpstan
    reportUnmatchedIgnoredErrors: false
    # PHPDoc shapes describe JSON read from the database; keep runtime guards such as array_values().
    treatPhpDocTypesAsCertain: false
