APP_NAME="Madina Natural Health Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
# Apex host without scheme or port. Portals use dealer, subdealer, manage and sadmin subdomains.
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=madina
DB_USERNAME=madina
DB_PASSWORD=local-development-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Null keeps a host-only session cookie. Do not share it across portal subdomains.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Enable only after the financial policy and opening balances are verified.
MADINA_FINANCIAL_ACTIVATION=false

# Enable only for a separate demonstration database; financial posting stays disabled.
MADINA_PREVIEW_MODE=false
MADINA_AUTO_RELEASE_MATURED=false
MADINA_AUTO_RELEASE_QUOTA_HOLDS=false
MADINA_BACKUPS_ENABLED=false
MADINA_BACKUP_PASSWORD=
TRUSTED_PROXIES=

# log = local/dev fallback only. Partner SMS always tries enabled Service integrations SMS providers first;
# app:readiness clears SMS go-live warnings when an SMS provider is enabled with base_url + api_key.
MADINA_SMS_DRIVER=log
MADINA_SMS_LOG_CHANNEL=stack
# Partner login SMS OTP after password (dealer/sub-dealer with a valid mobile).
# Owner can enable/disable from Security; MADINA_PREVIEW_MODE forces OTP off (no live SMS).
MADINA_LOGIN_OTP=true
MADINA_LOGIN_OTP_TTL=300
# Staff/owner TOTP after optional enrollment (never forced on first login). Forced off in preview.
MADINA_TOTP_ENABLED=true
# Optional manage/sadmin IP/CIDR allowlist (comma/space separated). Empty = unrestricted.
MADINA_ADMIN_IP_ALLOWLIST=
# Closed support/enquiry retention guidance (days) for PDPO readiness.
MADINA_PRIVACY_RETENTION_DAYS=365
# Encrypted backups: set a 32+ character password and MADINA_BACKUPS_ENABLED=true, then
# run `php artisan app:backup` and `php artisan app:backup-verify` before go-live.
