FROM node:24-bookworm-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY resources ./resources
COPY public ./public
COPY vite.config.* tsconfig.json ./
ENV VITE_APP_NAME="Madina Natural Health Care"
RUN npm run build

FROM postgres:16-bookworm AS postgres-tools
RUN mkdir /export && cp /usr/lib/postgresql/16/bin/pg_dump /usr/lib/postgresql/16/bin/pg_restore /export/ && cp -L /usr/lib/*-linux-gnu/libpq.so.5 /export/libpq.so.5

FROM php:8.4-fpm-bookworm AS app
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev libzip-dev libicu-dev libonig-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_pgsql bcmath intl zip gd mbstring opcache pcntl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY --from=postgres-tools /export/pg_dump /usr/local/bin/pg_dump
COPY --from=postgres-tools /export/pg_restore /usr/local/bin/pg_restore
COPY --from=postgres-tools /export/libpq.so.5 /usr/local/lib/libpq.so.5
RUN ldconfig
WORKDIR /var/www/html
COPY --chown=www-data:www-data . .
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-progress \
    && mkdir -p storage/app/private storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs /var/backups/madina \
    && chown -R www-data:www-data storage bootstrap/cache /var/backups/madina
COPY --from=frontend --chown=www-data:www-data /build/public/build ./public/build
COPY infra/php.production.ini /usr/local/etc/php/conf.d/production.ini
RUN chmod +x infra/production-entrypoint.sh
USER www-data
ENTRYPOINT ["/var/www/html/infra/production-entrypoint.sh"]
CMD ["php-fpm", "-F"]
EXPOSE 9000

FROM nginx:stable-alpine AS web
COPY infra/nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
EXPOSE 80
