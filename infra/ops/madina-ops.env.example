# Settings for the host scripts in infra/ops and infra/deploy. Copy to /etc/madina-ops.env on the server,
# `chmod 600 /etc/madina-ops.env`, owner root. Never commit the filled copy.

# The production stack folder (holds compose.production.yaml and .env.production).
STACK_DIR=/opt/madina-nhac
# Compose project name (the "name:" line of compose.production.yaml); used to find the Docker volumes.
COMPOSE_PROJECT=madina-production

# --- Host backup (infra/ops/host-backup.sh), the second copy beside the app's nightly backup ---
HOST_BACKUP_DIR=/var/backups/madina-host
# File holding the passphrase that encrypts host backups (one line, 32+ characters, chmod 600).
# Keep the same passphrase in the owner's password manager: without it the host backups cannot be opened.
HOST_BACKUP_PASSPHRASE_FILE=/root/.madina-host-backup-pass
# Days of host backups kept on this server; the newest 7 are always kept.
HOST_BACKUP_KEEP_DAYS=14

# --- Off-site copy with rclone (https://rclone.org; `rclone config` once to add the remote) ---
# Any rclone remote works: Backblaze B2, Cloudflare R2, Wasabi, AWS S3, Google Drive, another server over SFTP.
# Example: RCLONE_REMOTE=b2:madina-backups/vps1   Empty = no off-site copy (app:readiness keeps warning).
RCLONE_REMOTE=
# Daily copies older than this are removed from the remote; the copy made on the 1st of each month is kept
# in monthly/ for RCLONE_MONTHLY_KEEP_DAYS.
RCLONE_DAILY_KEEP_DAYS=35
RCLONE_MONTHLY_KEEP_DAYS=400

# --- Dead-man checks (healthchecks.io or similar). Separate checks for the host backup and the drill. ---
HOST_BACKUP_HEARTBEAT_URL=
RESTORE_DRILL_HEARTBEAT_URL=

# --- Deploys (infra/deploy) ---
# Releases whose images are kept for a quick rollback (the current one included).
KEEP_RELEASES=3
# Pre-deploy dumps, storage tars and release tarballs kept in PREDEPLOY_DIR (newest first).
PREDEPLOY_DIR=/root/madina-predeploy
PREDEPLOY_KEEP=10
# Disk use (percent) at which infra/ops/prune-host.sh also clears old Docker build cache.
DISK_PRUNE_PERCENT=80
