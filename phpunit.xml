<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_URL" value="http://example.test" force="true"/>
        <env name="APP_DOMAIN" value="example.test" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="madina_testing" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="MADINA_PREVIEW_MODE" value="false" force="true"/>
        <env name="MADINA_AGREEMENT_REQUIRED_DEFAULT" value="false" force="true"/>
        <!-- Tests read the translation words from the page props; TranslationBundleTest checks the real cached file. -->
        <env name="MADINA_INLINE_TRANSLATIONS" value="true" force="true"/>
        <!-- Older tests open the partner product list; PartnerCatalogSwitchTest checks it is off by default. -->
        <env name="MADINA_PARTNER_CATALOG" value="true" force="true"/>
        <!-- Older tests expect the browser's language to decide for a visitor who never chose; GuestLanguageTest turns the Bangla default on. -->
        <env name="MADINA_GUEST_LOCALE" value="" force="true"/>
        <!-- Real installs keep SMS and the sign-in picture off until a gateway exists. Tests keep both on unless a test turns them off. -->
        <env name="MADINA_LOGIN_OTP" value="true" force="true"/>
        <env name="MADINA_LOGIN_CAPTCHA" value="true" force="true"/>
        <!-- Owner/finance authenticator-app requirement: off here so other tests can sign staff in; LoginTotpRequiredTest turns it on. -->
        <env name="MADINA_TOTP_REQUIRED" value="false" force="true"/>
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
        <env name="SENTRY_DSN" value="" force="true"/>
        <env name="MADINA_SMS_DRIVER" value="array" force="true"/>
        <!-- Older order tests place an order first and pay later. FullPaymentWhenOrderingTest switches the owner setting on itself. -->
        <env name="MADINA_FULL_PAYMENT_WHEN_ORDERING" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
