{
  "name": "Nexora live preview",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/Business-Payment-System-Management",
  "remoteUser": "vscode",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "Nexora website", "onAutoForward": "openBrowser", "protocol": "http"}
  },
  "postCreateCommand": "bash scripts/codespaces-setup.sh",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "shutdownAction": "stopCompose"
}
