APP_NAME="Madina Natural Health Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-company-domain.example
# Apex host only, without scheme or port. Replace with the real APP_DOMAIN.
APP_DOMAIN=your-company-domain.example
# Leave SESSION_DOMAIN unset so dealer, subdealer, manage and sadmin each keep their own cookie.
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=madina
DB_USERNAME=madina
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=2100
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Madina Natural Health Care"
TRUSTED_PROXIES=172.16.0.0/12
MADINA_PREVIEW_MODE=false
# Owners and finance staff must use an authenticator app (set up at their next sign-in).
MADINA_TOTP_REQUIRED=true
MADINA_FINANCIAL_ACTIVATION=false
MADINA_AUTO_RELEASE_MATURED=false
MADINA_AUTO_RELEASE_QUOTA_HOLDS=false
MADINA_BACKUPS_ENABLED=true
MADINA_BACKUP_PASSWORD=
MADINA_BACKUP_DISK=backups
MADINA_BACKUP_PATH=/var/backups/madina
# Off-site backup copy and retention. Mount a volume from another machine (NAS, rclone mount
# of object storage) at MADINA_BACKUP_OFFSITE_PATH and set MADINA_BACKUP_OFFSITE_DISK=backups-offsite.
MADINA_BACKUP_OFFSITE_DISK=
MADINA_BACKUP_OFFSITE_PATH=
MADINA_BACKUP_RETENTION_DAYS=14
MADINA_BACKUP_KEEP_MINIMUM=7
# One JSON object per log line on stderr, so a log collector can search by field.
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DAILY_DAYS=30
# Alerts: add ",slack" to LOG_STACK and set the webhook to get critical errors (failed backups,
# failed payouts, queue backlog) in a Slack channel. Only "critical" and above are sent.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical
# Error tracking: paste the DSN from your free Sentry project (https://sentry.io). Empty = off.
# app:readiness warns when this is empty on production. Personal data is never sent.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Phone/browser push notifications: `php artisan webpush:vapid --show`, paste both keys. Empty = feature hidden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
