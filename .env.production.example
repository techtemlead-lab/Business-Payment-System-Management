APP_NAME="Madina Natural Health Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-company-domain.example
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=madina
DB_USERNAME=madina
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=2100
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Madina Natural Health Care"
TRUSTED_PROXIES=172.16.0.0/12
MADINA_PREVIEW_MODE=false
MADINA_FINANCIAL_ACTIVATION=false
MADINA_AUTO_RELEASE_MATURED=false
MADINA_BACKUPS_ENABLED=true
MADINA_BACKUP_PASSWORD=
MADINA_BACKUP_DISK=backups
MADINA_BACKUP_PATH=/var/backups/madina
