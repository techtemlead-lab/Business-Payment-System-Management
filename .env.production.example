APP_NAME="Madina Natural Health Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-company-domain.example
# Apex host only, without scheme or port. Replace with the real APP_DOMAIN.
APP_DOMAIN=your-company-domain.example
# Leave SESSION_DOMAIN unset so dealer, subdealer, manage and sadmin each keep their own cookie.
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=madina
DB_USERNAME=madina
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=2100
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Madina Natural Health Care"
TRUSTED_PROXIES=172.16.0.0/12
MADINA_PREVIEW_MODE=false
# Owners and finance staff must use an authenticator app (set up at their next sign-in).
MADINA_TOTP_REQUIRED=true
MADINA_FINANCIAL_ACTIVATION=false
MADINA_AUTO_RELEASE_MATURED=false
MADINA_AUTO_RELEASE_QUOTA_HOLDS=true
MADINA_BACKUPS_ENABLED=true
MADINA_BACKUP_PASSWORD=
MADINA_BACKUP_DISK=backups
MADINA_BACKUP_PATH=/var/backups/madina
# Off-site backup copy and retention. Mount a volume from another machine (NAS, rclone mount
# of object storage) at MADINA_BACKUP_OFFSITE_PATH and set MADINA_BACKUP_OFFSITE_DISK=backups-offsite.
MADINA_BACKUP_OFFSITE_DISK=
MADINA_BACKUP_OFFSITE_PATH=
MADINA_BACKUP_RETENTION_DAYS=14
MADINA_BACKUP_KEEP_MINIMUM=7
# One JSON object per log line on stderr, so a log collector can search by field.
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DAILY_DAYS=30
# Alerts: add ",slack" to LOG_STACK and set the webhook to get critical errors (failed backups,
# failed payouts, queue backlog) in a Slack channel. Only "critical" and above are sent.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical
# Error tracking: paste the DSN from your free Sentry project (https://sentry.io). Empty = off.
# app:readiness warns when this is empty on production. Personal data is never sent.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Phone/browser push notifications: `php artisan webpush:vapid --show`, paste both keys. Empty = feature hidden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services, written like mailto:owner@your-company-domain.example
VAPID_SUBJECT=
# Prescription module. Each partner still needs the owner's approval before they can prescribe.
MADINA_PRESCRIPTIONS=true
# Courier booking and tracking have no settings in this file. Turn on each courier and paste its
# keys in the owner portal under Service integrations. SMS gateway keys are entered there too.
# Partner SMS sign-in code. It needs a working SMS provider.
MADINA_LOGIN_OTP=true
MADINA_LOGIN_OTP_TTL=300
MADINA_TOTP_ENABLED=true
# "log" only writes messages to the log file. Real messages go through the provider set in Service integrations.
MADINA_SMS_DRIVER=log
MADINA_SMS_LOG_CHANNEL=stack
# Optional: only these IPs or CIDRs can open manage and sadmin (comma or space separated). Empty = no restriction.
MADINA_ADMIN_IP_ALLOWLIST=
# Starting value only; the owner changes it in Finance settings.
MADINA_FULL_PAYMENT_WHEN_ORDERING=true
MADINA_PRIVACY_RETENTION_DAYS=365
# Training uploads. A larger video limit also needs infra/php.production.ini and the nginx upload limit raised.
MADINA_TRAINING_DISK=local
MADINA_TRAINING_VIDEO_MAX_MB=100
MADINA_TRAINING_PDF_MAX_MB=20
# BDRIS identity lookup: only if the service is contracted.
MADINA_BDRIS_ENABLED=false
MADINA_BDRIS_BASE_URL=
MADINA_BDRIS_API_KEY=
MADINA_BDRIS_TIMEOUT=12
# Invoice and receipt letterhead. Leave these commented out to keep the built-in details;
# an empty value here would blank them on every printed invoice.
# MADINA_COMPANY_NAME=
# MADINA_COMPANY_ADDRESS=
# MADINA_COMPANY_PHONE=
# MADINA_COMPANY_EMAIL=
# MADINA_INVOICE_MANUFACTURER=
# MADINA_INVOICE_MARKETED_BY=
# MADINA_INVOICE_MARKETED_PHONES=
